# The stub of the Rust extension `bullterrier_control._native._core` (crates/python). The documentation is the
# extension's own (`help(_core.render)`, `help(Event)`). The formats' classes are the package's
# (`bullterrier_control.Event`, ...): their `__module__` is `bullterrier_control`.

from collections.abc import Callable, Mapping, Sequence
from typing import Any, ClassVar, Literal, Self, final

import numpy as np
from numpy.typing import ArrayLike, NDArray
from typing_extensions import disjoint_base

__all__ = [
    "Bundle",
    "Constant",
    "Event",
    "Grid",
    "ParamTable",
    "Rendered",
    "Series",
    "SignalBase",
    "Unit",
    "builtins",
    "bundle_schema",
    "dumps",
    "from_series",
    "from_values",
    "is_bundle_name",
    "make_signals_as",
    "maximum",
    "minimum",
    "parameters",
    "parse_parameters",
    "render",
    "shape",
    "shapers",
]

def render(name: str, inputs: NDArray[np.float64], params: Mapping[str, object]) -> NDArray[np.float64]: ...
def shapers() -> list[str]: ...
def builtins() -> list[str]: ...
def parameters(name: str) -> dict[str, dict[str, Any]]: ...
def parse_parameters(name: str, values: Mapping[str, object]) -> dict[str, Any]: ...

@final
class ParamTable:
    def __new__(cls, spec: Sequence[Mapping[str, object]], *, name: str) -> Self: ...
    def parse(self, values: Mapping[str, object]) -> dict[str, Any]: ...
    def describe(self) -> dict[str, dict[str, Any]]: ...

@final
class Unit:
    # the members are made from the core's list of units when the extension is imported
    FRACTION: ClassVar[Unit]
    DECIBELS: ClassVar[Unit]
    HERTZ: ClassVar[Unit]
    MIDI: ClassVar[Unit]
    RATIO: ClassVar[Unit]
    SECONDS: ClassVar[Unit]
    BEATS: ClassVar[Unit]
    @property
    def value(self) -> str: ...
    @property
    def name(self) -> str: ...
    def __eq__(self, value: object, /) -> bool: ...
    def __hash__(self) -> int: ...
    def __reduce__(self) -> tuple[Any, ...]: ...

