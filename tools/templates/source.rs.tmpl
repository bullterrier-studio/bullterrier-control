//! A signal that <what it is, in one sentence: its summary>.
//!
//! <What it promises in more words: what `help()` shows after the summary.>

use crate::{Error, Signal, Source};

/// <What the parameters of $name set.>
#[derive(Clone, Copy, Debug, PartialEq, crate::Params)]
pub struct Params {
    /// <What it does, its unit and range in words, and what raising it does.>
    #[param(default = 0.5, unit = Fraction, min = 0, max = 1)]
    pub level: f64,
}

impl Source for Params {
    const NAME: &'static str = "$name";
    type Inputs = ();

    /// The signal these parameters describe. The body only: [`lib::$name`](crate::lib::$name) checks the values
    /// against their ranges, names and records the signal. Replace the body; a source that needs history is a
    /// `Signal::rendered` over a causal recurrence instead (`slew.rs` is the model).
    ///
    /// ```
    /// use bullterrier_control::builtin::$name;
    /// use bullterrier_control::{lib, Source};
    ///
    /// let held = $name::Params { level: 0.25 };
    /// assert_eq!(held.source(())?.sample(&[0.0, 1.5, 3600.0])?, [0.25, 0.25, 0.25]);
    /// // the door refuses a value beyond its range
    /// assert!(lib::$name($name::Params { level: 2.0 }).is_err());
    /// # Ok::<(), bullterrier_control::Error>(())
    /// ```
    ///
    /// # Errors
    /// [`Error::Signal`] if `level` is not finite (a door has refused that before this is called).
    fn source(&self, (): ()) -> Result<Signal, Error> {
        Signal::constant(self.level)
    }
}

#[cfg(test)]
mod tests {
    use serde_json::json;

    use super::*;
    use crate::registry::{Call, Output};
    use crate::{Registry, lib};

    const TIMES: [f64; 3] = [0.0, 1.5, 3600.0];

    #[test]
    fn it_holds_its_level() -> Result<(), Error> {
        // Replace with what $name promises, each expected number worked out by hand.
        // a level of 0.25 reads as 0.25 at every time
        assert_eq!(Params { level: 0.25 }.source(())?.sample(&TIMES)?, [0.25; 3]);
        Ok(())
    }

    #[test]
    fn the_core_runs_it_by_name_with_its_parameters_checked() -> Result<(), Error> {
        let thing = Registry::builtin().get("$name")?;
        let held = thing.call(&Call { values: json!({"level": 0.75}), ..Call::default() })?;
        assert!(matches!(&held, Output::Signal(signal) if signal.sample(&TIMES).ok() == Some(vec![0.75; 3])), "{held:?}");
        let refused = thing.call(&Call { values: json!({"level": 2.0}), ..Call::default() });
        assert!(matches!(&refused, Err(Error::Params { shaper, .. }) if shaper == "$name"), "{refused:?}");
        Ok(())
    }

    #[test]
    fn the_typed_door_holds_the_same_and_refuses_the_same() -> Result<(), Error> {
        assert_eq!(lib::$name(Params { level: 0.75 })?.sample(&TIMES)?, [0.75; 3]);
        let refused = lib::$name(Params { level: -1.0 });
        assert!(matches!(&refused, Err(Error::Params { shaper, .. }) if shaper == "$name"), "{refused:?}");
        Ok(())
    }
}
