"""$name: <what it does to events, in a few words>."""

from ..plugin import Event, Finite, Params, operation, param


class ${title}Params(Params):
    """<What the parameters of $name set.>"""

    level: Finite = param(
        0.5,
        doc="<What it does, its unit and range in words, and what raising it does.>",
        unit="fraction",
        min=0,
        max=1,
    )


@operation(params=${title}Params)
def $name(params: ${title}Params, *, events: tuple[Event, ...]) -> tuple[Event, ...]:
    """<What the events out are, in one sentence: the summary `help(lib.$name)` shows.>"""
    return tuple(event for event in events if event.strength >= params.level)
