root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.md]
# two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false

[*.py]
indent_size = 4
max_line_length = 120

[*.{yaml,yml,toml,json}]
indent_size = 2

[pyproject.toml]
# uv rewrites the dependency arrays with four spaces
indent_size = 4
